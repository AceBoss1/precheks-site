rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'ezurukam@gmail.com',
        'precheks.info@gmail.com'
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Notes ────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount']);

      match /likes/{uid} {
        allow read, create, delete: if isSignedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isSignedIn()
          && (request.auth.uid == resource.data.authorUid || isAdmin());
      }
    }

    // ── Public profiles ──────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── Username reservations (uniqueness) ───────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
